# ============================================================
# Contoh konfigurasi MyFinance
# Salin file ini menjadi `.env` untuk development lokal, atau
# isi nilai-nilainya di Vercel: Project > Settings > Environment
# Variables. JANGAN pernah meng-commit `.env` berisi nilai asli.
# ============================================================

# true untuk development lokal; false untuk produksi (Vercel).
DEBUG=true

# String acak panjang — wajib di produksi.
# Buat dengan: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=ganti-dengan-string-acak-panjang

# Domain yang diizinkan. Untuk Vercel tambahkan domain akhiran .vercel.app
# atau domain custom kamu (dipisah koma).
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# --- Neon Postgres ---
# Ambil di Neon: Project > Connection Details. PAKAI endpoint berakhiran
# -pooler (PgBouncer) karena Vercel serverless sering cold-start.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER.neon.tech/neondb?sslmode=require

# --- Cloudinary (upload gambar; biarkan kosong bila tidak dipakai) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WebAuthn / biometrik (wajib di produksi, HTTPS) ---
WEBAUTHN_RP_NAME=MyFinance
WEBAUTHN_RP_ID=domain-kamu
WEBAUTHN_ORIGINS=https://domain-kamu

# --- Telegram bot (catat transaksi dari chat) ---
TELEGRAM_BOT_TOKEN=token-dari-BotFather
TELEGRAM_ALLOWED_CHAT_IDS=
